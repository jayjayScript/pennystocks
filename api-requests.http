### 1. Create Admin Account (Signup)
# Click "Send Request" below this line:
POST https://penny-stocks-backend.vercel.app/auth/signup
Content-Type: application/json

{
  "email": "info@pennystocksmarketplace.com",
  "password": "Godian1$",
  "firstName": "Penny",
  "lastName": "Stocks"
}

###

### 2. Test Admin Login (After setting isAdmin: true in Database)
# Click "Send Request" below this line:
POST https://penny-stocks-backend.vercel.app/admin/login
Content-Type: application/json

{
  "email": "admin@pennystocks.com",
  "password": "AdminPassword123!"
}

###

### 3. Test Standard Auth Login
# Click "Send Request" below this line:
POST https://penny-stocks-backend.vercel.app/auth/login
Content-Type: application/json

{
  "email": "admin@pennystocks.com",
  "password": "AdminPassword123!"
}

